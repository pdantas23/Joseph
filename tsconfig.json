{
  "compilerOptions": {
    /* Configurações de Saída e Alvo */
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    
    /* Resolução de Módulos */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Caminhos (Paths) - Substitui a necessidade de baseUrl */
    "paths": {
      "@/*": ["./client/src/*"],
      "server/*": ["./server/*"],
      "lib/*": ["./lib/*"]
    },

    /* Tipagens Globais */
    "types": ["node", "express", "multer"],

    /* Rigor e Interoperabilidade */
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "client/src/**/*", 
    "server/**/*", 
    "lib/**/*"
  ],
  "exclude": [
    "node_modules", 
    "build", 
    "dist"
  ]
}